        "kind": 30023,
        "pubkey": "ABABABABABABABABABABABABABABABABABABABABABABABABABABABABABABABAB",
        "identifier": "x"
      }
    },
    {
      "id": "kind-zero",
      "input": "0:abababababababababababababababababababababababababababababababab:x",
      "expected": {
        "kind": 0,
        "pubkey": "abababababababababababababababababababababababababababababababab",
        "identifier": "x"
      }
    },
    {
      "id": "empty-string",
      "input": "",
      "expected": null
    },
    {
      "id": "no-colon",
      "input": "caponata",
      "expected": null
    },
    {
      "id": "one-colon",
      "input": "30023:abababababababababababababababababababababababababababababababab",
      "expected": null
    },
    {
