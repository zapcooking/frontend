{
  "description": "Cross-platform NIP-01 a-tag coordinate vectors (web src/lib/coordinate.ts, Android nostr/Coordinate.kt). Only the first two colons separate fields; the identifier keeps every later colon. expected null = rejected.",
  "parse": [
    {
      "id": "simple",
      "input": "30023:abababababababababababababababababababababababababababababababab:caponata",
      "expected": {
        "kind": 30023,
        "pubkey": "abababababababababababababababababababababababababababababababab",
        "identifier": "caponata"
      }
    },
    {
      "id": "url-d-tag",
      "input": "30023:abababababababababababababababababababababababababababababababab:https://cooking.nytimes.com/recipes/1016445-caponata#recipe",
      "expected": {
        "kind": 30023,
        "pubkey": "abababababababababababababababababababababababababababababababab",
        "identifier": "https://cooking.nytimes.com/recipes/1016445-caponata#recipe"
      }
    },
    {
      "id": "title-colon-d-tag",
      "input": "30023:abababababababababababababababababababababababababababababababab:pasta:-weeknight",
      "expected": {
        "kind": 30023,
        "pubkey": "abababababababababababababababababababababababababababababababab",
        "identifier": "pasta:-weeknight"
      }
    },
    {
      "id": "many-colons",
      "input": "30023:abababababababababababababababababababababababababababababababab:a:b::c:",
      "expected": {
        "kind": 30023,
        "pubkey": "abababababababababababababababababababababababababababababababab",
        "identifier": "a:b::c:"
      }
    },
    {
      "id": "empty-identifier",
      "input": "10002:abababababababababababababababababababababababababababababababab:",
      "expected": {
        "kind": 10002,
        "pubkey": "abababababababababababababababababababababababababababababababab",
        "identifier": ""
      }
    },
    {
      "id": "uppercase-pubkey-kept",
      "input": "30023:ABABABABABABABABABABABABABABABABABABABABABABABABABABABABABABABAB:x",
